tube CRYO_OUT   G4_STAINLESS-STEEL            375.0000       +cm:3 -625.0000    625.0000 det=COIL
# HO, barrel yoke (iron 30 + 63 + 63 cm) and muon stations MB1-4, two gas layers each; approximate radii
tube HO0        G4_PLASTIC_SC_VINYLTOLUENE    382.0000       +cm:1 -126.0000    126.0000 det=HO layer=1 sens calo
tube TC         G4_Fe                         384.0000    +cm:19.5 -126.0000    126.0000 det=HO calo
