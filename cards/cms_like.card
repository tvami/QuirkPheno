tube EE         G4_PbWO4                       32.0000    171.0000  317.0000  +cm:22.000 det=EE sens calo mirror
# HCAL [D]: 3.7 mm scintillator layers; HB brass 15 x 5.5 cm between steel plates of 4 and 7.5 cm
tube HBF        G4_STAINLESS-STEEL            177.0000   +cm:4.000 -390.0000    390.0000 det=HB calo
