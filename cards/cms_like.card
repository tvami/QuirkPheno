tube ME4        MuonGas                       160.0000    700.0000 1010.0000       +cm:2 det=ME layer=4 sens mirror
# field: Bz[T] rmin rmax |z|min |z|max
field 3.8 0 315 0 600
field -1.8 460.0 490.0 0 635
field -1.8 540.0 603.0 0 635
field -1.8 650.0 713.0 0 635
# boundaries: name r |z|
boundary PIX 17 52
boundary TRK 115 280
boundary ECALIN 129 315
boundary HCALIN 177 390
boundary COIL 297 600
boundary MUON 420 690
boundary YOKEOUT 715 1000
