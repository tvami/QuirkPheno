# Generic CMS-like detector, written by make_cms_like.py (tk1.00_calo1.00_full_yoke)
# lengths in cm; '+x0:v' / '+lam:v' / '+cm:v' / '+um:v' = thickness from the inner edge
world 900 1150 G4_AIR
checkOverlaps 1
mix TkSupport 1.8 G4_C 0.55 G4_Al 0.15 G4_Cu 0.20 G4_KAPTON 0.10  # carbon fiber, cooling, cables
mix TkServ 3.6 G4_C 0.55 G4_Al 0.15 G4_Cu 0.20 G4_KAPTON 0.10      # same, denser: cables and pipes in the TIB-TID gap
mix MuonGas 0.00184 G4_Ar 0.837 G4_CARBON_DIOXIDE 0.163           # Ar/CO2 85/15 [D]
mix CoilMix 2.81 G4_Al 0.86 G4_Cu 0.08 G4_Ti 0.03 G4_Nb 0.03       # Al-stabilized NbTi conductor and mandrel
# beam pipe
tube PIPE_VAC   G4_Galactic                     0.0000      2.1700 -1100.0000   1100.0000 det=PIPE
tube PIPE       G4_Be                           2.1700    +cm:0.08 -300.0000    300.0000 det=PIPE
tube PIPEFWD    G4_STAINLESS-STEEL              2.1700    +cm:0.15  300.1000   1100.0000 det=PIPE mirror
# pixel barrel and forward disks [P]; support per layer tuned to about 1.2% X0
tube PXB1       G4_Si                           2.9000     +um:285  -26.7000     26.7000 det=PXB layer=1 sens
tube PXB1S      TkSupport                       2.9500 +x0:0.00900  -26.7000     26.7000 det=TKSUP layer=1
tube PXB2       G4_Si                           6.8000     +um:285  -26.7000     26.7000 det=PXB layer=2 sens
tube PXB2S      TkSupport                       6.8500 +x0:0.00900  -26.7000     26.7000 det=TKSUP layer=2
tube PXB3       G4_Si                          10.9000     +um:285  -26.7000     26.7000 det=PXB layer=3 sens
tube PXB3S      TkSupport                      10.9500 +x0:0.00900  -26.7000     26.7000 det=TKSUP layer=3
tube PXB4       G4_Si                          16.0000     +um:285  -26.7000     26.7000 det=PXB layer=4 sens
tube PXB4S      TkSupport                      16.0500 +x0:0.00900  -26.7000     26.7000 det=TKSUP layer=4
tube PXF1       G4_Si                           4.5000     16.1000   29.1000     +um:285 det=PXF layer=1 sens mirror
tube PXF1S      TkSupport                       4.5000     16.1000   29.1500 +x0:0.01200 det=TKSUP layer=1 mirror
tube PXF2       G4_Si                           4.5000     16.1000   39.6000     +um:285 det=PXF layer=2 sens mirror
tube PXF2S      TkSupport                       4.5000     16.1000   39.6500 +x0:0.01200 det=TKSUP layer=2 mirror
tube PXF3       G4_Si                           4.5000     16.1000   51.6000     +um:285 det=PXF layer=3 sens mirror
tube PXF3S      TkSupport                       4.5000     16.1000   51.6500 +x0:0.01200 det=TKSUP layer=3 mirror
tube PIXSERV    TkSupport                       4.5000     17.0000   56.0000 +x0:0.10000 det=TKSUP mirror
# strip tracker [D]; layers 1-2 of TIB and TOB are double sided (two sensors)
tube TIB1       G4_Si                          25.5000     +um:640  -70.0000     70.0000 det=TIB layer=1 sens
tube TIB1S      TkSupport                      25.6000 +x0:0.03000  -70.0000     70.0000 det=TKSUP layer=1
tube TIB2       G4_Si                          33.9000     +um:640  -70.0000     70.0000 det=TIB layer=2 sens
tube TIB2S      TkSupport                      34.0000 +x0:0.03000  -70.0000     70.0000 det=TKSUP layer=2
tube TIB3       G4_Si                          41.8500     +um:320  -70.0000     70.0000 det=TIB layer=3 sens
tube TIB3S      TkSupport                      41.9500 +x0:0.03000  -70.0000     70.0000 det=TKSUP layer=3
