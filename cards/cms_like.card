# endcap muon stations ME1-4 and yoke disks YE1-3 (60, 60, 25 cm, r > 1 m); approximate positions
tube ME11       MuonGas                       100.0000    275.0000  585.0000       +cm:2 det=ME layer=1 sens mirror
tube ME12       MuonGas                       275.0000    700.0000  690.0000       +cm:2 det=ME layer=1 sens mirror
tube YE1        G4_Fe                         100.0000    700.0000  730.0000      +cm:60 det=YOKE layer=4 mirror
