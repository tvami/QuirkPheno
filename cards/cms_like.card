tube TOBSERV    TkSupport                      57.0000    113.5000  111.0000 +x0:0.30000 det=TKSUP mirror
# ECAL [D]
tube EB         G4_PbWO4                      129.0000  +cm:23.000 -290.0000    290.0000 det=EB sens calo
tube ESPB1      G4_Pb                          45.0000    123.0000  298.0000       +x0:2 det=ES layer=1 calo mirror
tube ESSI1      G4_Si                          45.0000    123.0000  299.3000     +um:320 det=ES layer=1 sens calo mirror
tube ESPB2      G4_Pb                          45.0000    123.0000  299.5000       +x0:1 det=ES layer=2 calo mirror
